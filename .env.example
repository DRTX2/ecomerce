# =====================================================
# ENVIRONMENT VARIABLES (copy as .env)
# Default profile: dev
# =====================================================

# Active profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# -----------------------------------------------------
# DATABASE
# -----------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/amazon_db
DB_USERNAME=postgres
DB_PASSWORD=root

# -----------------------------------------------------
# SECURITY / JWT
# -----------------------------------------------------
# Use a strong key in production (>= 256 bits)
# Example: openssl rand -base64 32
JWT_SECRET_KEY=my-super-secret-key-for-development-only

# Token expiration (ms) – overrides profile defaults
# Dev defaults: access 24h | refresh 7d
# Prod defaults: access 15m | refresh 7d
# JWT_ACCESS_EXPIRATION=86400000
# JWT_REFRESH_EXPIRATION=604800000

# -----------------------------------------------------
# TOKEN CLEANUP
# -----------------------------------------------------
# Enable scheduled cleanup of revoked tokens
# TOKEN_CLEANUP_ENABLED=true

# Cleanup schedule (cron)
# Dev: every 30 min | Prod: every 6h
# TOKEN_CLEANUP_CRON=0 */30 * * * *

# Retention period for revoked tokens (days)
# Dev: 30 | Prod: 7
# REVOKED_TOKEN_RETENTION_DAYS=30

# -----------------------------------------------------
# LOGGING
# -----------------------------------------------------
# Levels: TRACE | DEBUG | INFO | WARN | ERROR
# APP_LOG_LEVEL=DEBUG
# AUTH_LOG_LEVEL=DEBUG
# SECURITY_LOG_LEVEL=DEBUG
# SPRING_SECURITY_LOG_LEVEL=DEBUG
# SQL_LOG_LEVEL=DEBUG

# -----------------------------------------------------
# CORS
# -----------------------------------------------------
# Dev defaults: http://localhost:3000,http://localhost:5173
# Prod: set your production domain
CORS_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------
# SERVER
# -----------------------------------------------------
SERVER_PORT=8080

# -----------------------------------------------------
# EMAIL (optional)
# -----------------------------------------------------
EMAIL_PROVIDER=azure
MAIL_USERNAME=
MAIL_PASSWORD=
TEST_EMAIL=test@example.com

# -----------------------------------------------------
# AZURE (optional)
# -----------------------------------------------------
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_SENDER_ADDRESS=DoNotReply@domain.com
AZURE_STORAGE_CONNECTION_STRING=

# -----------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------
STORAGE_CONTAINER_NAME=uploads
STORAGE_MAX_FILE_SIZE=5242880
STORAGE_MAX_FILES_COUNT=5
STORAGE_MAX_TOTAL_SIZE=20971520
STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# -----------------------------------------------------
# REDIS (optional)
# -----------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

