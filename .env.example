# DATABASE CONFIGURATION
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecomerce
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_password

# JWT CONFIGURATION
# IMPORTANT: Generate a secure 256-bit key for production
# Example: openssl rand -base64 32
JWT_SECRET_KEY=your-secret-key-minimum-256-bits-required-for-hs256-algorithm
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=86400000

# Access token: 15 minutes (900000 ms) - recommended for production
# Refresh token: 24 hours (86400000 ms) - adjust based on security requirements

# For development, you can increase these values:
# JWT_ACCESS_EXPIRATION=3600000    # 1 hour
# JWT_REFRESH_EXPIRATION=604800000 # 7 days

# REDIS CONFIGURATION
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave REDIS_PASSWORD empty if no authentication is required

# EMAIL CONFIGURATION (Azure Communication Services)
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=YOUR_ACCESS_KEY
AZURE_SENDER_ADDRESS=DoNotReply@your-domain.com

# Alternative: SMTP Configuration (if not using Azure)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-specific-password
# MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true


# STORAGE CONFIGURATION (Azure Blob Storage)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net
STORAGE_CONTAINER_NAME=product-images
# File size limits (in bytes):
STORAGE_MAX_FILES_COUNT=10
# 5MB = 5242880
STORAGE_MAX_FILE_SIZE=5242880
# 50MB = 52428800
STORAGE_MAX_TOTAL_SIZE=52428800
STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif

# CORS CONFIGURATION
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# SPRING PROFILES(dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# APPLICATION CONFIGURATION
SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_DRTX=DEBUG

# OPTIONAL: MONITORING & OBSERVABILITY

# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
# MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true

# DEVELOPMENT ONLY

# Uncomment for local development with Azurite (Azure Storage Emulator)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
